generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  MENTOR
  ADMIN
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(STUDENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  courses Course[]
}

model Course {
  id                String  @id @default(uuid())
  title             String
  subject           String
  description       String
  domain            String //CS,Engineering,Arts,Music etc
  thumbnailImageUrl String?
  videoUrl          String?
  notePdfUrl        String?

  teacherId String
  teacher   User   @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([teacherId])
  @@index([subject])
  @@index([domain])
}
