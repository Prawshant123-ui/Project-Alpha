{
  "compilerOptions": {
    /* Project */
    "rootDir": "./src",
    "outDir": "./dist",

    /* Language */
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    /* Node */
    "types": ["node"],
    "lib": ["ES2022"],

    /* Type Checking */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,

    /* Module */
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    /* Output */
    "sourceMap": true,

    /* Performance */
    "skipLibCheck": true
  },

  "include": [
    "src/**/*",
    "prisma/**/*"
  ],

  "exclude": [
    "node_modules",
    "dist"
  ]
}